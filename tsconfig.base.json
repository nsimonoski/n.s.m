{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@org/shared/contracts": ["libs/shared/contracts/src/index.ts"],
      "@org/shared/domain": ["libs/shared/domain/src/index.ts"],
      "@org/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@org/angular-file-explorer": ["libs/angular/features/file-explorer/src/index.ts"],
      "@org/react-file-explorer": ["libs/react/features/file-exporer/src/index.ts"],
      "@org/angular/ui": ["libs/angular/shared/ui/src/index.ts"],
      "@org/angular-utils": ["libs/angular/shared/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
