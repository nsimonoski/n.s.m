{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@org/shared/contracts": ["libs/shared/contracts/src/index.ts"],
      "@org/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@org/angular-file-explorer": ["libs/angular/features/file-explorer/src/index.ts"],
      "@org/react-file-explorer": ["libs/react/features/file-exporer/src/index.ts"],
      "@org/angular/ui": ["libs/angular/shared/ui/src/index.ts"],
      "@org/angular-utils": ["libs/angular/shared/utils/src/index.ts"],
      "@org/angular-ide": ["libs/angular/features/ide/src/index.ts"],
      "@org/angular-file-explorer-git": ["libs/angular/features/file-explorer-git/src/index.ts"],
      "@org/angular-code-editor": ["libs/angular/features/code-editor/src/index.ts"],
      "@org/angular-data-access": ["libs/angular/shared/data-access/src/index.ts"],
      "@org/react-code-editor": ["libs/react/features/code-editor/src/index.ts"],
      "@org/react-data-access": ["libs/react/shared/data-access/src/index.ts"],
      "@org/react-ui": ["libs/react/shared/ui/src/index.ts"],
      "@org/angular-auth": ["libs/angular/features/auth/src/index.ts"],
      "@org/angular-ai-chat": ["libs/angular/features/ai-chat/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
