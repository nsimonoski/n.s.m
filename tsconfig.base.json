{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,

    "importHelpers": true,
    "isolatedModules": true,

    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    "lib": ["es2022", "dom"],

    "skipLibCheck": true,
    "strict": true,

    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true
  },
  "exclude": ["node_modules", "tmp"]
}
