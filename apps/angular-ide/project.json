{
  "name": "angular-ide",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "ide",
  "sourceRoot": "apps/angular-ide/src",
  "tags": ["type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/angular-ide",
        "browser": "apps/angular-ide/src/main.ts",
        "tsConfig": "apps/angular-ide/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/angular-ide/public"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/assets"
          },
          {
            "glob": "**/*",
            "input": "node_modules/monaco-editor/min",
            "output": "monaco-editor/min"
          }
        ],
        "styles": ["apps/angular-ide/src/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/shared/styles/src"]
        },
        "baseHref": "/angular/"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "8mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "fileReplacements": [
            {
              "replace": "libs/shared/utils/src/lib/environment/environment.ts",
              "with": "libs/shared/utils/src/lib/environment/environment.prod.ts"
            }
          ],
          "outputHashing": "all"
        },
        "uat": {
          "fileReplacements": [
            {
              "replace": "libs/shared/utils/src/lib/environment/environment.ts",
              "with": "libs/shared/utils/src/lib/environment/environment.uat.ts"
            }
          ],
          "outputHashing": "all",
          "sourceMap": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "angular-ide:build:production"
        },
        "development": {
          "buildTarget": "angular-ide:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/angular-ide/proxy.conf.json",
        "servePath": "/angular/"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/test-output/jest/coverage"],
      "options": {
        "jestConfig": "apps/angular-ide/jest.config.cts",
        "tsConfig": "apps/angular-ide/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "angular-ide:build",
        "staticFilePath": "dist/apps/angular-ide/browser",
        "spa": true
      }
    }
  }
}
