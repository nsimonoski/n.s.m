{
  "name": "angular-file-explorer-git",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/angular/features/file-explorer-git/src",
  "prefix": "ide",
  "projectType": "library",
  "tags": ["scope:angular", "type:feature"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "../../../../coverage/libs/angular/features/file-explorer-git"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
